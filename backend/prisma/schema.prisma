// Esquema relacional — Fase Inicial (TiendaYa)
// Fuente de diseño: IA/ERD.md (Página 1, confirmada como base del proyecto)
//
// El catálogo descriptivo (categoria, subcategoria, atributo_categoria,
// atributo_producto, categoria_producto, y descripcion/imagen_url/estado de
// producto) vivió acá durante la Fase Inicial y se migró a MongoDB en
// Entrega 1 (ver IA/ADR-002). Esas tablas/columnas se borraron el
// 2026-08-30 — ningún código las escribía ni las leía desde que
// categoriaService.js se reescribió contra Mongo; mantenerlas vacías no
// tenía ningún propósito. Lo que queda acá es exactamente lo que MySQL
// sigue necesitando: usuarios/auth, direcciones/pagos, y la parte
// transaccional del catálogo (producto como ancla de FK + inventario +
// compras), que es intencionalmente donde se concentra la consistencia
// fuerte de todo el sistema. Ver IA/ADR-002 §3.4.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model rol_usuario {
  id       Int        @id @default(autoincrement())
  tipo_rol String

  usuarios usuarios[]
  // Lo que un administrador cambió para este rol desde /admin/permisos (ver acl_regla).
  reglas   acl_regla[]
}

model usuarios {
  id_usuario       Int      @id @default(autoincrement())
  rol_id           Int
  nombres          String
  apellidos        String
  correo           String   @unique
  contrasena       String
  fecha_nacimiento DateTime @db.Date
  // Antigüedad de la cuenta — señal real de fraude (una cuenta creada hace
  // minutos que ya dispara una señal pesa distinto que una con meses de
  // historial), pero no existía ningún campo de alta hasta ahora. Al
  // agregarlo sobre una tabla con filas ya existentes, esas filas quedan con
  // la fecha de esta migración, no su alta real — no hay forma de recuperar
  // ese dato porque nunca se guardó. Solo es confiable desde acá en
  // adelante, ver comentario en fraudeService.js.
  creado_en        DateTime @default(now())
  // Se incrementa bajo el lock del usuario con cada modificación del carrito.
  carrito_version  Int      @default(0)

  rol          rol_usuario   @relation(fields: [rol_id], references: [id])
  direcciones  direcciones[]
  metodos_pago metodo_pago[]
  compras      compra[]
  carritos     carrito[]
  productos    producto[]
  // Suspensiones de esta cuenta, y las que esta cuenta (un administrador) revisó.
  bloqueos           bloqueo_cuenta[] @relation("bloqueo_de_usuario")
  bloqueos_revisados bloqueo_cuenta[] @relation("bloqueo_revisado_por")
  // Las reglas de permisos que esta cuenta (un administrador) cambió por última vez.
  reglas_acl_editadas acl_regla[] @relation("acl_regla_autor")
}

model direcciones {
  id            Int    @id @default(autoincrement())
  id_usuario    Int
  pais          String
  direccion     String
  codigo_postal String

  usuario usuarios @relation(fields: [id_usuario], references: [id_usuario])
  compras compra[]
}

// El número completo de la tarjeta nunca se guarda aquí: lo custodia la pasarela
// de pago, que devuelve un token de referencia (ver IA/ERD.md, observación 1.4.2).
model metodo_pago {
  id                Int    @id @default(autoincrement())
  id_usuario        Int
  titular           String
  token_pasarela    String
  ultimos_4_digitos String @db.VarChar(4)
  marca             String @db.VarChar(30)

  usuario usuarios @relation(fields: [id_usuario], references: [id_usuario])
  pagos   pago[]
}

// id_vendedor: cada producto pertenece a un único vendedor (agregado a pedido del
// equipo — el modelo original del ERD no distinguía qué vendedor gestiona qué
// producto, así que cualquier "vendedor" podía editar el catálogo de cualquier otro).
//
// Solo ancla de FK desde el 2026-08-30: lo descriptivo (descripcion/imagen_url/
// estado/atributos/categoría) vive únicamente en Mongo (Producto.js) desde
// Entrega 1 — esta fila existe para que inventario/compra_detalle/carrito
// tengan algo relacional a qué apuntar, nada más.
model producto {
  id          Int    @id @default(autoincrement())
  id_vendedor Int

  vendedor        usuarios         @relation(fields: [id_vendedor], references: [id_usuario])
  inventario      inventario?
  carritos        carrito[]
  compra_detalles compra_detalle[]
}

// 1:1 con producto (ver IA/ERD.md, observación 1.4.6). Si más adelante se necesita
// inventario por bodega/lote, quitar el @unique y agregar una dimensión (p. ej. almacen_id).
model inventario {
  id          Int     @id @default(autoincrement())
  id_producto Int     @unique
  precio      Decimal @db.Decimal(10, 2)
  cantidad    Int

  producto producto @relation(fields: [id_producto], references: [id])
}

model carrito {
  id          Int    @id @default(autoincrement())
  id_usuario  Int
  id_producto Int
  cantidad    Int
  estado      String

  usuario  usuarios @relation(fields: [id_usuario], references: [id_usuario])
  producto producto @relation(fields: [id_producto], references: [id])

  @@unique([id_usuario, id_producto])
}

model compra {
  id           Int      @id @default(autoincrement())
  id_usuario   Int
  id_direccion Int
  total        Decimal  @db.Decimal(10, 2)
  fecha        DateTime @default(now())
  // Constancia de que una cuenta que puede vender (vendedor/administrador)
  // aceptó el compromiso de no reventa en el aviso de ESTA compra — es lo que
  // vuelve exigible la cláusula de los Términos de Servicio si después aparece
  // una publicación equivalente (ver compromisoService.js y
  // PLAN-NEO4J-DETECCION-FRAUDE.md §19). NULL = comprador, o un pedido anterior
  // a la regla: no hay forma de reconstruir un compromiso que nunca se pidió.
  no_reventa_aceptada_en DateTime?

  usuario         usuarios         @relation(fields: [id_usuario], references: [id_usuario])
  direccion       direcciones      @relation(fields: [id_direccion], references: [id])
  compra_detalles compra_detalle[]
  pagos           pago[]
}

// Agregada en el análisis del ERD (observación 1.4.1): separa el instrumento guardado
// (metodo_pago) del cobro real de cada compra. Una compra puede tener varios pagos
// (reintentos, reembolsos).
model pago {
  id                      Int      @id @default(autoincrement())
  id_compra               Int
  id_metodo_pago          Int
  monto                   Decimal  @db.Decimal(10, 2)
  estado                  String
  fecha_pago              DateTime @default(now())
  referencia_transaccion  String?

  compra      compra      @relation(fields: [id_compra], references: [id])
  metodo_pago metodo_pago @relation(fields: [id_metodo_pago], references: [id])
}

// cantidad: faltaba en el ERD original (Página 1) — sin ella, precio_final (el
// total de la línea) no se puede desglosar en precio unitario × unidades, así
// que ni el historial de pedidos podía mostrar cuántas unidades se compraron.
model compra_detalle {
  id           Int     @id @default(autoincrement())
  id_compra    Int
  id_producto  Int
  cantidad     Int
  precio_final Decimal @db.Decimal(10, 2)
  descuento    Decimal @db.Decimal(10, 2) @default(0)
  estado       String

  compra   compra   @relation(fields: [id_compra], references: [id])
  producto producto @relation(fields: [id_producto], references: [id])
}

// Outbox transaccional: la venta y su pendiente de envío se confirman juntos.
// Se conserva el snapshot financiero aunque después cambie el catálogo; no
// incluye información personal. detalle_id evita encolar dos veces una línea.
// No lleva FK con borrado en cascada: el evento debe sobrevivir por sí mismo.
model venta_outbox {
  detalle_id      Int       @id
  payload         Json
  creado_en       DateTime  @default(now())
  procesado_en    DateTime?
  intentos        Int       @default(0)
  proximo_intento DateTime  @default(now())
  ultimo_error    String?   @db.Text

  @@index([procesado_en, proximo_intento, detalle_id])
}

// Un intento sobrevive a respuestas perdidas. Pedido y respuesta se confirman
// en la misma transacción. Nunca se borran al vaciar el carrito.
model checkout_intento {
  id              String    @id @db.VarChar(36)
  id_usuario      Int
  ambito          String    @db.VarChar(160)
  version_carrito Int?
  items           Json?
  datos_hash      String?   @db.VarChar(64)
  reserva         Json?
  estado          String    @default("pendiente") @db.VarChar(16)
  compra_id       Int?      @unique
  respuesta       Json?
  error           Json?
  compensado      Boolean   @default(false)
  creado_en       DateTime  @default(now())
  actualizado_en  DateTime  @updatedAt

  @@index([id_usuario, ambito])
  @@index([estado, actualizado_en])
}

// Dos ventanas preparan la misma sesión. Renovarla exige el identificador
// anterior (compare-and-swap), por lo que dos renovaciones tampoco se duplican.
model checkout_sesion {
  id_usuario Int
  ambito     String @db.VarChar(160)
  intento_id String @db.VarChar(36)

  @@id([id_usuario, ambito])
}

// Caso de suspensión temporal de una cuenta por un hallazgo de fraude de
// confianza ALTA (ver bloqueoService.js e IA/PLAN-NEO4J-DETECCION-FRAUDE.md §20).
// Esta tabla es el REGISTRO durable — qué hallazgo, cuándo, quién lo revisó y qué
// decidió —; el bloqueo que se hace cumplir en cada petición vive en Redis
// (`bloqueo:{id_usuario}`, con un TTL igual a lo que falta para `expira_en`, que
// es lo que lo hace vencer solo). Redis es volátil: si se pierde,
// bloqueoService.reconciliar() lo reconstruye desde acá.
//
// (id_usuario, huella) es único: un hallazgo suspende a una cuenta UNA vez. Sin
// eso el barrido volvería a bloquear cada minuto a quien ya cumplió su suspensión
// o a quien un administrador ya liberó, porque el grafo no olvida el hallazgo.
// `huella` identifica el hallazgo (señal + cuentas + lo que lo hace único); un
// hallazgo distinto de la misma cuenta sí abre un caso nuevo.
//
// estado: 'activo' (suspendida), 'liberado' (un administrador lo levantó antes de
// tiempo) o 'expirado' (venció sin que nadie lo levantara). La revisión
// (revisado_*) se anota con cualquier decisión humana, incluida extender.
//
// tipo (respuesta escalonada, PLAN §21): 'suspension' = hallazgo de confianza ALTA,
// la cuenta no puede entrar (candado `bloqueo:{id}` en Redis); 'restriccion' =
// hallazgo «posible», la cuenta sigue comprando pero con límites suaves (candado
// `restriccion:{id}`: tope por pedido, menos pedidos por hora y contraseña en cada
// pedido). Un mismo hallazgo puede tener un caso de cada tipo: primero «posible» y,
// si más tarde lo corrobora otra señal, «alta» — por eso el único incluye el tipo.
model bloqueo_cuenta {
  id            Int       @id @default(autoincrement())
  id_usuario    Int
  huella        String    @db.VarChar(160)
  senal         String    @db.VarChar(40)
  tipo          String    @default("suspension") @db.VarChar(12)
  origen        String    @default("automatico") @db.VarChar(12)
  motivo        String    @db.Text
  evidencia     Json?
  estado        String    @default("activo") @db.VarChar(12)
  creado_en     DateTime  @default(now())
  expira_en     DateTime
  revisado_por  Int?
  revisado_en   DateTime?
  nota_revision String?   @db.VarChar(500)

  usuario usuarios  @relation("bloqueo_de_usuario", fields: [id_usuario], references: [id_usuario])
  revisor usuarios? @relation("bloqueo_revisado_por", fields: [revisado_por], references: [id_usuario])

  @@unique([id_usuario, huella, tipo])
  @@index([estado, expira_en])
}

// Permisos de la API que un administrador cambió desde /admin/permisos (ver IA/ADR-007, §9). La política BASE
// vive en el código (config/politicaRutas.js, la lista blanca que prueban tests/accesoRutas.test.js); esta tabla
// guarda solo las DIFERENCIAS: «el rol X sí/no puede en la ruta Y». Sin fila, vale lo que declara el código —así
// una ruta nueva funciona desde el primer día y «restaurar» es borrar filas—. `ruta` es la clave de la lista
// blanca («GET /api/admin/ventas»); solo se aplican las rutas declaradas como editables y nunca al administrador.
model acl_regla {
  id              Int      @id @default(autoincrement())
  rol_id          Int
  ruta            String   @db.VarChar(200)
  permitido       Boolean
  actualizado_por Int?
  actualizado_en  DateTime @default(now())

  rol   rol_usuario @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  autor usuarios?   @relation("acl_regla_autor", fields: [actualizado_por], references: [id_usuario], onDelete: SetNull)

  @@unique([rol_id, ruta])
  @@index([ruta])
}
