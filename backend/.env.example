# Copiar este archivo a ".env" (no versionado) y ajustar si hace falta.
# Los valores por defecto ya coinciden con los defaults de docker-compose.yml.

# Debe coincidir con las credenciales del servicio "mysql" en docker-compose.yml (raíz del repo)
# allowPublicKeyRetrieval=true: el usuario tiendaya usa caching_sha2_password
# (default de MySQL 8.4) — sin esto, la PRIMERA conexión de un pool nuevo sin
# TLS puede fallar pidiendo la clave RSA del servidor ("RSA public key is not
# available client side"), lo que se manifiesta como un "pool timeout"
# confuso (active=0 idle=0) sin este detalle a la vista. Root-cause muy
# probable de los "pool timeout" intermitentes documentados en
# IA/ESTADO-PROYECTO.md que antes solo se resolvían reiniciando el backend.
DATABASE_URL="mysql://tiendaya:tiendaya@localhost:3306/tiendaya?allowPublicKeyRetrieval=true"

# Catálogo descriptivo (ver IA/ADR-002) — replicaSet requerido para transacciones (ver IA/ADR-003).
# Puerto 27018, no el 27017 por defecto de Mongo: evita chocar con un MongoDB
# nativo de Windows que pueda estar corriendo en 127.0.0.1:27017 fuera de este
# proyecto (ver IA/ADR-002, notas de implementación).
MONGO_URI="mongodb://localhost:27018/tiendaya?replicaSet=rs0"

# Carrito (Entrega 2, ver IA/ENTREGA-2-PLAN.md §4.1) — dato transitorio, sin
# auth ni persistencia especial (ver docker-compose.yml). Si en Windows el
# contenedor de Redis no arranca con un error de PERMISOS de bind (no "puerto
# ocupado"), 6379 probablemente cae en un rango que Hyper-V/WSL2 reserva en
# esa máquina (ver el comentario del servicio redis en docker-compose.yml) —
# la solución es un REDIS_HOST_PORT distinto en un .env en la raíz del repo,
# reflejado acá con el mismo puerto.
REDIS_URL="redis://localhost:6379"

# Panel de ventas: Cassandra es una copia de lectura; MySQL conserva pedidos,
# pagos y pendientes durables. Si Node corre en Docker, usar cassandra como host.
CASSANDRA_CONTACT_POINTS="127.0.0.1"
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER="datacenter1"
CASSANDRA_KEYSPACE="tiendaya_analytics"

# Analítica pausada temporalmente durante las pruebas de oferta flash.
# OUTBOX=false omite las consultas extra de captura dentro del checkout.
# SYNC=false detiene el worker periódico; los pendientes existentes se conservan.
# Para reactivar: ambas en true, reiniciar el backend y ejecutar ventas:historico
# para incorporar las compras realizadas mientras la captura estuvo desactivada.
VENTAS_OUTBOX_ENABLED=false
VENTAS_SYNC_ENABLED=false
VENTAS_SYNC_INTERVAL_MS=30000
VENTAS_SYNC_BATCH_SIZE=50

# Detección de fraude (Entrega 2, ver IA/PLAN-NEO4J-DETECCION-FRAUDE.md).
# Contraseña de desarrollo — coincide con NEO4J_PASSWORD (o el default
# tiendaya_dev) en docker-compose.yml.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="tiendaya_dev"

# Suspensión temporal de cuentas por fraude de confianza alta (ver
# IA/PLAN-NEO4J-DETECCION-FRAUDE.md §20). Cada INTERVALO_MS el backend corre las
# señales de fraude y suspende las cuentas con un hallazgo de nivel "alta"; el
# bloqueo vive en Redis con un TTL de HORAS (admite decimales: 0.5 = 30 minutos) y
# un administrador revisa cada caso en /admin/bloqueos. ENABLED=false apaga el
# barrido: los bloqueos ya abiertos se siguen respetando y se pueden liberar.
FRAUDE_BLOQUEO_ENABLED=true
FRAUDE_BLOQUEO_HORAS=24
FRAUDE_BLOQUEO_INTERVALO_MS=60000

# Respuesta escalonada y prevención de pedidos (ver IA/PLAN-NEO4J-DETECCION-FRAUDE.md §21).
# Un hallazgo de nivel "posible" no suspende: deja a la cuenta bajo vigilancia durante
# FRAUDE_RESTRICCION_HORAS (admite decimales) con límites suaves — su contraseña en cada
# pedido, un tope de monto por pedido (RESTRICCION_MONTO_MAXIMO, en quetzales; 0 = sin
# tope de monto) y menos pedidos por hora (RESTRICCION_PEDIDOS_HORA; 0 = sin tope propio).
# RESTRICCION_ENABLED=false apaga TODOS los límites suaves (los casos ya abiertos quedan
# sin efecto). Un administrador nunca queda bajo vigilancia.
RESTRICCION_ENABLED=true
FRAUDE_RESTRICCION_HORAS=24
RESTRICCION_MONTO_MAXIMO=500
RESTRICCION_PEDIDOS_HORA=2
# Tope general de pedidos por hora de cualquier cuenta: el pedido de más se rechaza ANTES
# de completarse (contador en Redis; un pedido que falla no gasta el cupo). 0 = sin tope.
LIMITE_PEDIDOS_HORA=5

# Búsqueda de productos (Entrega 3, ver IA/PLAN-ELASTICSEARCH-BUSQUEDA.md).
# Sin autenticación en desarrollo (xpack.security.enabled=false en
# docker-compose.yml) — deliberado, ver §5 del plan; control de acceso NoSQL
# es un requerimiento de Entrega Final, no de esta.
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDICE="tiendaya_productos"

PORT=3000

# Secreto de desarrollo únicamente — reemplazar por un valor real antes de producción
JWT_SECRET="dev-secret-cambiar-en-produccion"
