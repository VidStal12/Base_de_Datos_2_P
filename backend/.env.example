# Copiar este archivo a ".env" (no versionado) y ajustar si hace falta.
# Los valores por defecto ya coinciden con los defaults de docker-compose.yml.

# Debe coincidir con las credenciales del servicio "mysql" en docker-compose.yml (raíz del repo)
# allowPublicKeyRetrieval=true: el usuario tiendaya usa caching_sha2_password
# (default de MySQL 8.4) — sin esto, la PRIMERA conexión de un pool nuevo sin
# TLS puede fallar pidiendo la clave RSA del servidor ("RSA public key is not
# available client side"), lo que se manifiesta como un "pool timeout"
# confuso (active=0 idle=0) sin este detalle a la vista. Root-cause muy
# probable de los "pool timeout" intermitentes documentados en
# IA/ESTADO-PROYECTO.md que antes solo se resolvían reiniciando el backend.
DATABASE_URL="mysql://tiendaya:tiendaya@localhost:3306/tiendaya?allowPublicKeyRetrieval=true"

# Catálogo descriptivo (ver IA/ADR-002) — replicaSet requerido para transacciones (ver IA/ADR-003).
# Puerto 27018, no el 27017 por defecto de Mongo: evita chocar con un MongoDB
# nativo de Windows que pueda estar corriendo en 127.0.0.1:27017 fuera de este
# proyecto (ver IA/ADR-002, notas de implementación).
MONGO_URI="mongodb://localhost:27018/tiendaya?replicaSet=rs0"

# Carrito (Entrega 2, ver IA/ENTREGA-2-PLAN.md §4.1) — dato transitorio, sin
# auth ni persistencia especial (ver docker-compose.yml).
REDIS_URL="redis://localhost:6379"

# Panel de ventas: Cassandra es una copia de lectura; MySQL conserva pedidos,
# pagos y pendientes durables. Si Node corre en Docker, usar cassandra como host.
CASSANDRA_CONTACT_POINTS="127.0.0.1"
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER="datacenter1"
CASSANDRA_KEYSPACE="tiendaya_analytics"

# El worker reintenta pendientes después de confirmar el checkout. false permite
# usar únicamente los comandos manuales ventas:sincronizar / ventas:historico.
VENTAS_SYNC_ENABLED=true
VENTAS_SYNC_INTERVAL_MS=30000
VENTAS_SYNC_BATCH_SIZE=50

PORT=3000

# Secreto de desarrollo únicamente — reemplazar por un valor real antes de producción
JWT_SECRET="dev-secret-cambiar-en-produccion"
